# Custom partition table for English firmware (No Chinese voice_data, larger app and model partitions)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/labplus_Ledong_v2/partitions-16MiB-en.csv"

# Disable Chinese speech recognition models
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_MN_CN_MULTINET7_QUANT=n
CONFIG_SR_MN_CN_NONE=y

# Enable English speech recognition models (WakeNet9 Hi ESP + Alexa + MultiNet7 EN)
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_WN_WN9_ALEXA=y
CONFIG_SR_MN_EN_NONE=n
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# Set log level to ERROR
CONFIG_LOG_DEFAULT_LEVEL_INFO=n
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL=1


